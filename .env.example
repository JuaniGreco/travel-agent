# ==============================================================================
# CONFIGURACIÓN DEL TRACKER DE PRECIOS - FLORIDA 2027
# ==============================================================================
# Copiá este archivo a `.env` y ajustá los valores según tus necesidades:
#   cp .env.example .env
#
# Ciberseguridad: el archivo `.env` está en .gitignore y NUNCA debe subirse a Git.
# ==============================================================================

# --- Parámetros Generales ---
TRIP_NAME="Florida 2027"

# --- Presupuestos Base Pagados / de Referencia (en USD) ---
# Si no tenés un monto cerrado aún (ej. Hard Rock), dejalo vacío para que alerte
# automáticamente ante nuevos mínimos históricos.
CABANA_BAY_BASE_USD=1174.00
HARD_ROCK_BASE_USD=
POP_CENTURY_BASE_USD=2406.00
AVIS_SUV_BASE_USD=260.00

# --- Tolerancias y Reglas de Decisión ---
# Tolerancia máxima para la regla de privacidad (2 habitaciones dobles <= base + tolerancia)
TOLERANCIA_PRIVACIDAD_USD=400.00
# Alerta de verificación si el precio es menor al 50% de la base (posible precio por noche/sin impuestos)
UMBRAL_SOSPECHOSO=0.50
# Impuesto local de Orange County (Universal y Disney: 6.5% sales + 6% tourist development tax)
TAX_ORLANDO=0.125

# --- Configuración de Navegación y Anti-Bot ---
# Modo headless: false recomendado en entornos residenciales para reducir detección de bots
BROWSER_HEADLESS=false
# Canal del navegador ("chrome" usa Google Chrome real instalado; dejar vacío para Chromium de Playwright)
BROWSER_CHANNEL=chrome
# Tiempos de espera por búsqueda (en segundos)
SEARCH_TIMEOUT_SECONDS=90
SEARCH_SETTLE_SECONDS=4
# Pausa aleatoria entre búsquedas (segundos min y max) para emular comportamiento humano
PAUSE_BETWEEN_SEARCHES_MIN=8
PAUSE_BETWEEN_SEARCHES_MAX=25
# Guardar payloads JSON de la última ejecución en capturas/ultima/ para diagnóstico
GUARDAR_PAYLOADS=true

# --- Notificaciones Opcionales (Futuro / Black Friday Alerts) ---
# Notificaciones instantáneas adicionales además de bitacora_precios.md
# DISCORD_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
